{
  "expo": {
    "name": "NekSathi",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.mobilesafetyapp.r8ptmu",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Share your live location during an SOS",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Keep family updated with your location",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#06060f"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.mobilesafetyapp.r8ptmu",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#06060f"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Share your live location during an SOS",
          "locationAlwaysAndWhenInUsePermission": "Keep family updated with your live location",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
